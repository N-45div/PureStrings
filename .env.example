# PayPal: a sandbox app from PayPal's Developer Dashboard (Apps & Credentials), with saving payment methods
# (Vault) turned on. The demo shop, Bean & Leaf, charges through it.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=sandbox
# The webhook added for the shop (npm run paypal:webhook -- https://<your PureStrings>/shop/paypal/webhook prints it).
# PAYPAL_WEBHOOK_ID=
# Tests only: a sandbox payer's PayPal saved with the app, so the tests charge it for real in the sandbox, and refund it.
# PAYPAL_SANDBOX_VAULT_ID=

# Nemotron on Nebius Token Factory: turns what you say into a cart or an allowance, and drafts disputes.
# NEBIUS_API_KEY=
